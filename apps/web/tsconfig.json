{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@hexara/shared": ["../../packages/shared/src/index.ts"],
      "@hexara/shared/*": ["../../packages/shared/src/*"],
      "@hexara/game-core": ["../../packages/game-core/src/index.ts"],
      "@hexara/game-core/*": ["../../packages/game-core/src/*"],
      "@hexara/protocol": ["../../packages/protocol/src/index.ts"],
      "@hexara/protocol/*": ["../../packages/protocol/src/*"]
    }
  },
  "include": ["src"]
}
